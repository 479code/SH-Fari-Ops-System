+  }
+  .filter-count {
+    font-size: 9px;
+  }
+  th {
+    font-size: 9px;
+    padding: 12px;
+  }
+  td {
+    font-size: 11px;
+    padding: 14px 12px;
+  }
+  .surface-head {
+    padding: 17px 15px;
+  }
+  .surface-body {
+    padding: 16px;
+  }
+  .surface-head h2 {
+    font-size: 15px;
+  }
+  .pump-grid {
+    grid-template-columns: 1fr;
+  }
+  .pump-card {
+    display: grid;
+    grid-template-columns: 75px 1fr;
+    column-gap: 21px;
+    padding: 20px;
+  }
+  .pump-card > .row {
+    grid-column: 1/-1;
+  }
+  .pump-visual {
+    grid-column: 1;
+    grid-row: 2/6;
+    align-self: center;
+    margin: 20px 0;
