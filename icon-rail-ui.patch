+  }
+  .stat label {
+    font-size: 10px;
+  }
+  .stat small {
+    font-size: 9px;
+  }
+  .filter-bar {
+    padding: 12px;
+    gap: 7px;
+  }
+  .filter-search {
+    max-width: none;
+    flex-basis: 100%;
+  }
+  .input,
+  .select {
+    font-size: 12px;
