+@media (prefers-reduced-motion: reduce) {
+  * {
+    animation: none !important;
+    transition: none !important;
+    scroll-behavior: auto !important;
+  }
+}
+@media print {
+  .icon-rail,
+  .sidebar,
+  .topbar,
+  .page-actions,
+  .filter-bar,
+  .app-footer,
+  .toast-stack,
+  .btn,
+  .link,
+  .attention-panel {
+    display: none !important;
+  }
+  .app-shell {
+    display: block;
+  }
+  .content {
+    padding: 0;
+  }
+  .table-scroll {
+    max-height: none;
+    overflow: visible;
+  }
+  .surface,
+  .pump-card {
+    break-inside: avoid;
+  }
+  .twin-layout {
+    display: block;
+  }
+  .network {
+    display: block;
+  }
+  .network-map {
+    display: none;
+  }
+  body {
+    background: white;
+  }
