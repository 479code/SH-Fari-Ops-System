+/* Dialogs and drawers */
+.overlay {
+  position: fixed;
+  inset: 0;
+  z-index: 60;
+  background: #0d293f70;
+  backdrop-filter: blur(4px);
+  display: flex;
+  align-items: center;
+  justify-content: center;
+  padding: 24px;
+}
+.dialog {
+  background: white;
+  border-radius: 13px;
+  width: 580px;
+  max-width: 100%;
+  max-height: 90dvh;
+  display: flex;
+  flex-direction: column;
+  box-shadow: 0 20px 90px #102d4240;
+  overflow: hidden;
+}
+.dialog-head {
+  padding: 22px 24px 18px;
+  border-bottom: 1px solid var(--line);
+  display: flex;
+  justify-content: space-between;
+  gap: 18px;
+  align-items: flex-start;
+}
+.dialog-head h2 {
+  font-size: 20px;
+  letter-spacing: -0.7px;
+}
+.dialog-head .eyebrow {
+  font-size: 9px;
+  margin-bottom: 6px;
+}
+.dialog-body {
+  padding: 24px;
+  overflow: auto;
+  min-height: 0;
+}
+.dialog-footer {
+  padding: 16px 24px;
+  display: flex;
+  justify-content: flex-end;
+  gap: 9px;
+  border-top: 1px solid var(--line);
+  background: #fafcfc;
+  flex-wrap: wrap;
+}
+.overlay.drawer {
+  justify-content: flex-end;
+  padding: 0;
+}
+.drawer .dialog {
+  height: 100dvh;
+  max-height: 100dvh;
+  width: 460px;
+  border-radius: 12px 0 0 12px;
+}
+.detail-grid {
+  display: grid;
+  grid-template-columns: 1fr 1.5fr;
+  font-size: 12px;
+  margin: 0;
+}
+.detail-grid dt,
+.detail-grid dd {
+  margin: 0;
+  padding: 13px 0;
+  border-bottom: 1px solid var(--line);
+  overflow-wrap: anywhere;
+}
+.detail-grid dt {
+  color: var(--muted);
+}
+.detail-grid dd {
+  font-weight: 550;
+  color: #37586e;
+}
+.drawer-value {
+  font-size: 34px;
+  letter-spacing: -1px;
+  font-weight: 700;
+  margin: 12px 0 21px;
+}
+.audit-timeline {
+  border-left: 1px solid var(--line);
+  padding-left: 18px;
+  margin: 20px 0;
+}
+.audit-event {
+  position: relative;
+  padding: 0 0 20px;
+  font-size: 11px;
+  color: #5e788a;
+}
+.audit-event:before {
+  content: "";
+  position: absolute;
+  left: -22px;
+  top: 4px;
+  width: 7px;
+  height: 7px;
+  border-radius: 50%;
+  background: #7898aa;
+  border: 2px solid white;
+}
+.audit-event small {
+  font-size: 9px;
+  color: #95a6b0;
+  display: block;
+  margin-top: 5px;
+}
+.toast-stack {
+  position: fixed;
+  bottom: 23px;
+  right: 24px;
+  z-index: 90;
+  display: flex;
+  flex-direction: column;
+  gap: 10px;
+}
+.toast {
+  max-width: 350px;
+  background: var(--navy);
+  border: 1px solid #496274;
+  color: white;
+  padding: 13px 17px;
+  border-radius: 8px;
+  font-size: 12px;
+  box-shadow: 0 7px 30px #17334630;
+}
+.skeleton {
+  height: 13px;
+  background: linear-gradient(90deg, #eaf0f3, #f9fbfc, #eaf0f3);
+  background-size: 200% 100%;
+  animation: loading 1s linear infinite;
+  border-radius: 4px;
+  margin: 15px 0;
+}
+.skeleton:nth-child(2) {
+  width: 65%;
+}
+.skeleton:nth-child(3) {
+  width: 85%;
+}
+@keyframes loading {
+  to {
+    background-position: -200% 0;
+  }
+}
