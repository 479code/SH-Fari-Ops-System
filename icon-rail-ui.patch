+/* Recorded tank levels, independent of the station artwork. */
+.station-art {
+  position: absolute;
+  left: 0;
+  top: 50%;
+  width: 100%;
+  aspect-ratio: 1672/941;
+  transform: translateY(-50%);
+  z-index: 0;
+  pointer-events: none;
+}
+.station-art .station-scene {
+  z-index: 0;
+  width: 100%;
+  height: 100%;
+  object-fit: fill;
+}
+.tank-interior {
+  position: absolute;
+  z-index: 1;
+  background: none;
+  border: 0;
+  padding: 0;
+  pointer-events: auto;
+  transition: filter 0.2s;
+}
+.tank-interior:hover {
+  filter: brightness(1.07);
+}
+.tank-interior-0 {
+  left: 24.1%;
+  top: 66.1%;
+  width: 26.3%;
+  height: 17.1%;
+  transform: rotate(-1deg);
+}
+.tank-interior-1 {
+  left: 55.4%;
+  top: 65.9%;
+  width: 22%;
+  height: 16.3%;
+  transform: rotate(-0.5deg);
+}
+.recorded-liquid {
+  width: 100%;
+  height: 100%;
+  display: block;
+  overflow: visible;
+}
+.fluid-fill {
+  transition:
+    y 0.6s ease,
+    height 0.6s ease;
+}
+.unknown-tank {
+  display: grid;
+  place-items: center;
+  background: #dae3e4;
+  color: #627986;
+  font-size: 11px;
+  border-radius: 30%;
+  box-shadow: inset 0 0 15px #9daeb4;
+}
+.tank-label .variance-label.warn {
+  background: var(--amber-pale);
+  color: #946a20;
+}
+.tank-label .variance-label.ok {
+  background: var(--green-pale);
+  color: var(--green);
+}
+.tank-label .variance-label.bad {
+  background: var(--red-pale);
+  color: var(--red);
+}
+.tank-level-preview {
+  max-width: 320px;
+  height: 130px;
+  margin: 5px auto 10px;
+}
+.tank-scale-note {
+  font-size: 10px;
+  color: var(--muted);
+  text-align: center;
+  margin-bottom: 20px;
+}
+.tank-history {
+  margin-top: 25px;
+  border-top: 1px solid var(--line);
