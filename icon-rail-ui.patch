+}
+.recorded-tank-card {
+  grid-template-columns: 125px minmax(0, 1fr);
+}
+.tank-card-graphic {
+  border: 0;
+  padding: 0;
+  background: none;
+  width: 125px;
+  height: 65px;
+}
+@media (max-width: 850px) {
