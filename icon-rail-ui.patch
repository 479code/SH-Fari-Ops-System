+    font-size: 22px;
+  }
+  .tank-grid {
+    grid-template-columns: 1fr;
+  }
+  .tank-card {
+    grid-template-columns: 90px 1fr;
+    padding: 21px;
+  }
+  .tank-cutaway {
+    display: block;
+    width: 83px;
+    height: 140px;
+  }
+  .tank-info > strong {
+    font-size: 25px;
+  }
