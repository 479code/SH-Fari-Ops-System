{
  "name": "shfari-ops-api",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "SH Fari Ops — Station Management & Financial Control API",
  "scripts": {
    "dev": "bun --watch src/index.ts",
    "start": "NODE_ENV=production bun src/index.ts",
    "build": "bun build src/index.ts --target=bun --outdir=dist --sourcemap=linked",
    "start:dist": "NODE_ENV=production bun dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "bun test --env-file=.env.test",
    "db:generate": "bunx --bun drizzle-kit generate",
    "db:migrate": "bun src/db/migrate.ts",
    "db:seed": "bun src/db/seed.ts",
    "db:seed:demo": "bun src/db/seed-demo.ts",
    "admin:reset-password": "bun src/db/reset-admin-password.ts",
    "db:studio": "bunx --bun drizzle-kit studio"
  },
  "dependencies": {
    "drizzle-orm": "^0.45.2",
    "hono": "^4.13.7",
    "mysql2": "^3.24.4",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "drizzle-kit": "^0.31.10",
    "typescript": "^5.9.0"
  }
}
