# SH Fari Ops — environment configuration
# Copy to backend/.env and fill in real values. Never commit real secrets.
# Every variable is validated at startup (backend/src/config/env.ts).

# --- Runtime -------------------------------------------------------------------
NODE_ENV=development            # development | test | production
PORT=3000
HOST=127.0.0.1                  # 0.0.0.0 / :: to listen on all interfaces
LOG_LEVEL=info                  # debug | info | warn | error | silent
BUSINESS_TIMEZONE=Africa/Lagos  # business dates (DSR day, month-to-date) use this zone

# --- Database (MariaDB / MySQL) ---------------------------------------------------
DATABASE_HOST=127.0.0.1
DATABASE_PORT=3306
DATABASE_NAME=shfari
DATABASE_USER=shfari
DATABASE_PASSWORD=
DATABASE_POOL_SIZE=10

# --- Authentication -------------------------------------------------------------------
# Generate each with: openssl rand -base64 48   (minimum 32 characters)
AUTH_SECRET=                    # keys the HMAC of password-reset tokens
SESSION_SECRET=                 # keys the HMAC of session tokens
SESSION_IDLE_MINUTES=60         # sign out after this much inactivity
SESSION_ABSOLUTE_HOURS=12       # maximum session length
LOGIN_MAX_ATTEMPTS=5            # consecutive failures before an account locks
LOGIN_LOCKOUT_MINUTES=15
PASSWORD_RESET_TTL_MINUTES=60

# --- HTTP --------------------------------------------------------------------------------
# Browser origins allowed to call the API with credentials (comma-separated).
# Not needed when the backend serves the frontend itself (same origin).
CORS_ORIGIN=http://127.0.0.1:3000,http://localhost:3000
FRONTEND_DIR=../frontend        # static frontend, relative to backend/; empty = API only
TRUST_PROXY=false               # true only behind a reverse proxy that sets X-Forwarded-*
# Session cookie is Secure (HTTPS-only) by default in production. Browsers drop
# Secure cookies on plain http://, so sign-in cannot stick. Set false ONLY if the
# app is genuinely served over http:// (e.g. an internal IP without TLS).
COOKIE_SECURE=
API_RATE_LIMIT_PER_MINUTE=600   # per client IP
LOGIN_RATE_LIMIT_PER_MINUTE=10  # per client IP

# --- Seeding (bun run db:seed) ----------------------------------------------------------
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_PASSWORD=            # leave empty to generate one (printed once); must be changed at first sign-in
SEED_ADMIN_NAME=System Administrator
